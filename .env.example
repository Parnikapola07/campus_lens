# CampusLens — Local AI Configuration
# The app uses local Ollama inference on your machine. No external cloud AI API keys required.

# Ollama API Base URL (Use 127.0.0.1 on Windows to ensure direct IPv4 binding without IPv6 ::1 lookup issues)
OLLAMA_BASE_URL="http://127.0.0.1:11434"

# Model name pulled via Ollama (e.g., gemma4:e2b)
OLLAMA_MODEL="gemma4:e2b"

# Web server port
PORT=3000

# Optional app host URL
APP_URL="http://localhost:3000"

